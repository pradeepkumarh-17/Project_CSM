# Copy to .env and fill the values for local development
# You can either set DATABASE_URL directly:
# DATABASE_URL=mysql+pymysql://stress_user:StrongPassword123@127.0.0.1:3306/stress_db
# OR set individual DB_* variables (recommended to avoid embedding passwords in VCS)
# Example using individual variables (recommended):
DB_USER=stress_user
DB_PASS=StrongPassword123
DB_HOST=localhost
DB_NAME=stress_db
# Note: MySQL treats 'user'@'localhost' and 'user'@'127.0.0.1' as different accounts.
# If you see permissions issues, either change to 'localhost' here or create/grant the user for 127.0.0.1 as well.
# For a simple local dev you can use SQLite:
# DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-me-to-a-secure-random-value
